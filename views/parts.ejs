<%- include('partials/header') %>

<section class="page-head">
  <div class="container">
    <%- include('partials/crumbs', { items: [[sec.title]] }) %>
    <h1 class="page-title"><%= sec.title %></h1>
    <p class="page-lead"><%= sec.lead %></p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="part-grid">
      <% sec.cats.forEach(function (c) { %>
        <a class="part-card" href="<%= c.href %>">
          <span class="part-card__img"><% if (c.img) { %><img src="<%= c.img %>" alt="<%= c.title %>" loading="lazy"><% } %></span>
          <span class="part-card__name"><%= c.title %></span>
          <span class="part-card__link"><%= c.items.length %> товаров →</span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/consult', { source: sec.title }) %>
<%- include('partials/footer') %>
