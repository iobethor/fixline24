<a class="project-card" href="/portfolio/<%= p.slug %>/">
  <span class="project-card__img"><img src="<%= p.img %>" alt="<%= p.title %>" loading="lazy"></span>
  <span class="project-card__body">
    <span class="project-card__client"><%= p.client %> <i>·</i> <%= p.place %></span>
    <span class="project-card__title"><%= p.title %></span>
    <span class="project-card__more">Смотреть проект →</span>
  </span>
</a>
