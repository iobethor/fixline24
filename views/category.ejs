<%- include('partials/header') %>

<section class="page-head">
  <div class="container">
    <%- include('partials/crumbs', { items: [[cat.title]] }) %>
    <h1 class="page-title"><%= cat.title %></h1>
    <p class="page-lead"><%= cat.lead %></p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="svc-grid">
      <% cat.items.forEach(function (i, n) { %>
        <a class="svc-card" href="/<%= cat.slug %>/<%= i.slug %>/">
          <span class="svc-card__img"><img src="<%= i.img %>" alt="<%= i.title %>" loading="lazy"></span>
          <span class="svc-card__body"><small><%= String(n + 1).padStart(2, '0') %></small><span><%= i.menu %></span><i>→</i></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/consult', { source: cat.title }) %>

<%- include('partials/footer') %>
