<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Админ-панель — <%= siteName %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/admin-assets/admin.css?v=<%= v %>">
</head>
<body>
<% if (!loggedIn) { %>
  <main class="login">
    <form class="login__box" id="login">
      <div class="login__logo"><span class="mark"></span> <b><%= siteName %></b></div>
      <h1>Вход в админ-панель</h1>
      <% if (!configured) { %>
        <p class="warn">Пароль ещё не задан. Добавьте переменную <code>ADMIN_PASSWORD</code> в Secrets на Replit (или в окружение сервера) и перезапустите сайт.</p>
      <% } %>
      <label>Пароль<input type="password" name="password" autocomplete="current-password" autofocus <%= configured ? '' : 'disabled' %>></label>
      <button class="btn btn--acc" <%= configured ? '' : 'disabled' %>>Войти</button>
      <p class="login__err" id="login-err"></p>
      <a class="login__back" href="/">← На сайт</a>
    </form>
  </main>
  <script>
    document.getElementById('login').addEventListener('submit', async function (e) {
      e.preventDefault();
      var err = document.getElementById('login-err');
      err.textContent = '';
      var r = await fetch('/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: this.password.value }) });
      var j = await r.json().catch(function () { return {}; });
      if (j.ok) location.reload(); else err.textContent = j.error || 'Ошибка входа';
    });
  </script>
<% } else { %>
  <div class="app">
    <aside class="side" id="side">
      <div class="side__head">
        <span class="mark"></span>
        <div><b><%= siteName %></b><small>админ-панель</small></div>
      </div>
      <nav class="side__nav" id="nav"></nav>
      <div class="side__foot">
        <a href="/" target="_blank">Открыть сайт ↗</a>
        <button id="logout">Выйти</button>
        <small id="storage"></small>
      </div>
    </aside>
    <main class="main">
      <header class="bar">
        <button class="bar__menu" id="menu" aria-label="Меню">☰</button>
        <div class="bar__title"><h1 id="title">Загрузка…</h1><p id="hint"></p></div>
        <div class="bar__actions" id="actions"></div>
      </header>
      <div class="content" id="content"></div>
    </main>
  </div>
  <div class="toast" id="toast"></div>
  <div class="modal" id="modal" hidden><div class="modal__box"><div class="modal__head"><h3 id="modal-title"></h3><button id="modal-close">×</button></div><div id="modal-body"></div></div></div>
  <input type="file" id="file" hidden>
  <script src="/admin-assets/admin.js?v=<%= v %>"></script>
<% } %>
</body>
</html>
